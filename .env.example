# Observatory only. Never put Binance trading credentials here.
# Verified HTTPS endpoints implementing the SANSA contract in README.md.
SOURCE_URLS=
POLL_SECONDS=60
STALE_SECONDS=1800
# Required only for the public profile.
DOMAIN=
BASIC_AUTH_USER=observatory
# Generate with: docker run --rm -it caddy:2-alpine caddy hash-password
# Preserve dollar signs by single-quoting the hash.
BASIC_AUTH_HASH=''
